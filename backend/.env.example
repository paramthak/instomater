OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ElevenLabs TTS defaults favor expressive v3 reel voiceovers.
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TTS_LANGUAGE_CODE=en
ELEVENLABS_TTS_STABILITY=0.45
ELEVENLABS_TTS_SIMILARITY_BOOST=0.9
ELEVENLABS_TTS_STYLE=0.25
ELEVENLABS_TTS_SPEED=1.1
ELEVENLABS_TTS_USE_SPEAKER_BOOST=true
ELEVENLABS_MALE_VOICE_ID=PdJQAOWyIMAQwD7gQcSc
ELEVENLABS_FEMALE_VOICE_ID=Cvv0EXhC1Zv7b4a2QfWl

GEMINI_TEXT_MODEL=gemini-2.5-flash

# Vertex AI for Veo video generation
GCP_PROJECT_ID=my-project-123456
GCP_LOCATION=us-central1
GCP_SERVICE_ACCOUNT_PATH=./service-account.json
VEO_FAST_MODEL=veo-3.1-fast-generate-001
VEO_STANDARD_MODEL=veo-3.1-generate-001
VEO_RESOLUTION=720p
VEO_SAMPLE_COUNT=2
